rules_version = '2';

// Dada Tracker — Firestore 보안 규칙
//
// v3에는 이 파일이 저장소에 없었습니다. 다인 서비스에서 규칙이 없거나 느슨하면
// 아무 계정이나 남의 정신건강·생리주기 기록을 읽습니다. 민감정보이므로
// 배포 전에 반드시 적용해야 합니다.
//
// 적용 방법 두 가지 (둘 중 하나만 하면 됩니다)
//   1. Firebase 콘솔: 빌드 → Firestore Database → 규칙 탭 →
//      이 파일 내용을 통째로 붙여넣고 '게시' 클릭
//   2. Firebase CLI: firebase deploy --only firestore:rules
//
// 콘솔에서 직접 수정하면 이 파일과 실제 적용된 규칙이 어긋납니다.
// 수정은 항상 이 파일에서 하고, 그 내용을 콘솔에 다시 붙여넣으시기 바랍니다.
//
// 원칙: 본인의 users/{uid} 하위만, 로그인한 상태에서만 접근합니다.
// 컬렉션 그룹 질의는 허용하지 않습니다(경로 기반 규칙만 사용).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function inScale(value) {
      return value is int && value >= 1 && value <= 5;
    }

    // 쓰기 크기 상한. 실수나 악의로 문서를 부풀리는 것을 막습니다.
    function memoWithinLimit(data) {
      return !('memo' in data) || (data.memo is string && data.memo.size() <= 20000);
    }

    function tagsWithinLimit(data) {
      return !('tagIds' in data) || (data.tagIds is list && data.tagIds.size() <= 200);
    }

    // ── 프로필 ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly([
                         'uid', 'email', 'displayName', 'modules', 'theme', 'reminder',
                         'consent', 'crisisBannerDismissedAt', 'onboardedAt',
                         'createdAt', 'updatedAt', 'createdAtServer', 'appVersion',
                         'schemaVersion', 'migratedAt'
                       ]);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // ── 일일 기록 ───────────────────────────────────────────────────────
      // 문서 ID는 반드시 YYYY-MM-DD이고, date 필드와 일치해야 합니다.
      match /entries/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && isDateKey(date)
                              && (!('date' in request.resource.data) || request.resource.data.date == date)
                              && (!('mood' in request.resource.data) || inScale(request.resource.data.mood))
                              && (!('energy' in request.resource.data) || inScale(request.resource.data.energy))
                              && (!('sleep' in request.resource.data)
                                  || request.resource.data.sleep in ['little', 'good', 'too_much'])
                              && (!('sleepHours' in request.resource.data)
                                  || (request.resource.data.sleepHours is number
                                      && request.resource.data.sleepHours >= 0
                                      && request.resource.data.sleepHours <= 24))
                              && memoWithinLimit(request.resource.data)
                              && tagsWithinLimit(request.resource.data);
      }

      // ── 태그 ────────────────────────────────────────────────────────────
      match /tags/{tagId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 60
                              && request.resource.data.categoryId is string;
      }

      match /tagCategories/{categoryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 40;
      }

      // ── 생리주기 ────────────────────────────────────────────────────────
      match /cycles/{cycleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && isDateKey(request.resource.data.startDate)
                              && (request.resource.data.endDate == null
                                  || (isDateKey(request.resource.data.endDate)
                                      && request.resource.data.endDate >= request.resource.data.startDate));
      }

      // ── 관찰 (사용자가 계속 지켜보기로 한 관계) ─────────────────────────
      match /observations/{observationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.patternId is string
                              && request.resource.data.patternId.size() > 0
                              && request.resource.data.patternId.size() <= 200
                              && request.resource.data.label is string
                              && request.resource.data.label.size() > 0
                              && request.resource.data.label.size() <= 200
                              && isDateKey(request.resource.data.startedOn);
      }

      // ── 메타 (마이그레이션 상태, v3 원본 백업) ──────────────────────────
      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 그 밖의 모든 경로는 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
